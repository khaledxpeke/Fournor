---
import { gammes, ingFamilies, navigation, xpNav, xpTree } from "virtual:fournor-catalog";
import { t } from "../i18n.js";
import { alternates, loc, localePath } from "../lib/locale.js";

const { locale = "fr", active = "", path = "/" } = Astro.props;
const tr = (key) => t(key, locale);
const href = (to) => localePath(locale, to);
const label = (id) => xpNav[id]?.[locale] || xpNav[id]?.fr || id;
const alts = alternates(path);
const on = (id) => (active === id ? " is-active" : "");
const solActive = active === "solution";
const mixActive = active === "gamme";
const ingActive = active === "ingredients";
const menu = navigation?.[locale]?.main || [];
const menuItem = (to) => menu.find((item) => item.href === href(to));
const menuLabel = (to, key) => menuItem(to)?.label || tr(key);
const menuHref = (to) => menuItem(to)?.href || href(to);
const codes = [
  ["fr", "FR"],
  ["en", "EN"],
  ["ar", "AR"],
];
---

<header class="site-header">
  <a class="brand" href={href("/")} aria-label="SATIA">
    <img class="logo-satia" src="/logo-satia.webp" alt="SATIA" width="220" height="126" draggable="false" />
  </a>
  <nav class="nav" id="site-nav" aria-label="Primary">
    <a class={`nav-link${on("home")}`} href={menuHref("/")}>{menuLabel("/", "nav.home")}</a>
    <a class={`nav-link${on("maison")}`} href={menuHref("/maison/")}>{menuLabel("/maison/", "nav.maison")}</a>
    <div class:list={["nav-item", "nav-item-mega", { "is-active": solActive }]}>
      <a
        class:list={["nav-link", "nav-link-wrap", { "is-active": solActive }]}
        href={menuHref("/solution/")}
        aria-haspopup="true"
        aria-expanded="false">{menuLabel("/solution/", "nav.solution")}</a>
      <div class="nav-mega">
        <div class="nav-mega-cats">
          {
            xpTree.map((col) => (
              <div class:list={["nav-mega-row", { "has-kids": (col.children || []).length > 0 }]}>
                <a class="nav-mega-head" href={href(`/xp/${col.id}/`)} data-xp-nav={col.id}>{label(col.id)}</a>
                {(col.children || []).length > 0 && (
                  <div class="nav-mega-kids">
                    {col.children.map((id) => (
                      <a href={href(`/xp/${id}/`)} data-xp-nav={id}>{label(id)}</a>
                    ))}
                  </div>
                )}
              </div>
            ))
          }
        </div>
      </div>
    </div>
    <div class:list={["nav-item", "nav-item-mega", { "is-active": mixActive }]}>
      <a
        class:list={["nav-link", { "is-active": mixActive }]}
        href={menuHref("/gamme/")}
        aria-haspopup="true"
        aria-expanded="false">{menuLabel("/gamme/", "nav.melanges")}</a>
      <div class="nav-mega nav-mega-simple">
        <div class="nav-mega-cats">
          {gammes.map((gamme) => (
            <div class="nav-mega-row"><a class="nav-mega-head" href={href(`/gamme/${gamme.slug}/`)}>{loc(gamme.name, locale)}</a></div>
          ))}
        </div>
      </div>
    </div>
    <div class:list={["nav-item", "nav-item-mega", { "is-active": ingActive }]}>
      <a
        class:list={["nav-link", { "is-active": ingActive }]}
        href={menuHref("/ingredients/")}
        aria-haspopup="true"
        aria-expanded="false">{menuLabel("/ingredients/", "nav.ingredients")}</a>
      <div class="nav-mega nav-mega-simple">
        <div class="nav-mega-cats">
          {
            ingFamilies.map((id) => (
              <div class="nav-mega-row">
                <a class="nav-mega-head" href={href(`/ingredients/${id}/`)} data-xp-nav={id}>{label(id)}</a>
              </div>
            ))
          }
        </div>
      </div>
    </div>
    <a class={`nav-link nav-link-wrap${on("formation")}`} href={menuHref("/formation/")}>{menuLabel("/formation/", "nav.formation")}</a>
    <a class={`nav-link${on("partenaires")}`} href={menuHref("/partenaires/")}>{menuLabel("/partenaires/", "nav.partners")}</a>
    <a class={`nav-link${on("contact")}`} href={menuHref("/contact/")}>{menuLabel("/contact/", "nav.contact")}</a>
  </nav>
  <div class="header-tools">
    <div class="lang" role="group" aria-label={tr("nav.lang")}>
      {
        codes.map(([code, text]) => (
          <a
            href={alts[code]}
            hreflang={code}
            data-set-lang={code}
            aria-current={code === locale ? "page" : undefined}
          >{text}</a>
        ))
      }
    </div>
    <button class="nav-toggle" type="button" aria-label={tr("nav.open")} aria-expanded="false" aria-controls="site-nav">
      <span></span><span></span>
    </button>
  </div>
</header>
