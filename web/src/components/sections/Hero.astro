---
import CmsImage from "../CmsImage.astro";
import { videoPoster } from "../../lib/images.js";

const { block } = Astro.props;
const file = block?.image;
const src = file?.url || "";
const video =
  (typeof file?.mime === "string" && file.mime.startsWith("video/")) ||
  src.includes("/video/upload/") ||
  /\.(mp4|webm|mov)(?:$|\?)/i.test(src);
const bouton = block?.bouton;
const poster = video ? videoPoster(src) : "";
---
<section class="hero">
  {video ? (
    <video
      class="hero-bg"
      src={src}
      poster={poster || undefined}
      muted
      autoplay
      loop
      playsinline
      preload="metadata"
      aria-hidden="true"
    />
  ) : (
    <CmsImage src={src} alt={block?.titre || ""} slot="hero" fetchpriority="high" />
  )}
  <div class="wrap">
    {block?.titre && <h1>{block.titre}</h1>}
    {block?.sousTitre && <p>{block.sousTitre}</p>}
    {bouton?.lien && <a class="btn btn-gold" href={bouton.lien}>{bouton.libelle}</a>}
  </div>
</section>
