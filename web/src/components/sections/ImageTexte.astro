---
import CmsImage from "../CmsImage.astro";

const { block } = Astro.props;
const src = block?.image?.url || "";
const bouton = block?.bouton;
---
<section class="section">
  <div class="wrap page-open">
    {src && (
      <figure class="page-open-photo">
        <CmsImage src={src} alt={block?.titre || ""} slot="page" />
      </figure>
    )}
    <div class="page-open-copy">
      {block?.surtitre && <p class="kicker">{block.surtitre}</p>}
      {block?.titre && <h2>{block.titre}</h2>}
      {block?.chapo && <p class="lead">{block.chapo}</p>}
      {block?.texte && <p set:html={block.texte} />}
      {bouton?.lien && <a class="btn btn-gold" href={bouton.lien}>{bouton.libelle}</a>}
    </div>
  </div>
</section>
