---
import "../styles/main.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { t } from "../i18n.js";
import { absolute, alternates } from "../lib/locale.js";

const {
  title,
  description,
  page,
  active,
  mix,
  product,
  fam,
  xp,
  preload,
  preloadSrcset,
  preloadSizes,
  locale = "fr",
  path = "/",
  ogImage = "/logo-satia.webp",
  extraLd = [],
} = Astro.props;

const nav = active || (page === "produit" ? "gamme" : page === "xp" ? "solution" : page);
const alts = alternates(path);
const canonical = absolute(alts[locale] || path);
const ogLocale = locale === "ar" ? "ar_TN" : locale === "en" ? "en_GB" : "fr_TN";
const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "SATIA",
  url: "https://fournor.com/",
  logo: "https://fournor.com/logo-satia.webp",
  telephone: "+21698692222",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Route de Korbous km 2",
    postalCode: "8020",
    addressLocality: "Soliman",
    addressRegion: "Nabeul",
    addressCountry: "TN",
  },
};
const jsonLd = [organization, ...extraLd];
---

<!doctype html>
<html lang={locale} dir={locale === "ar" ? "rtl" : "ltr"}>
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("fournor-lang");
          if (saved !== "en" && saved !== "ar" && saved !== "fr") return;
          var current = document.documentElement.lang || "fr";
          if (saved === current) return;
          var parts = location.pathname.split("/").filter(Boolean);
          if (parts[0] === "en" || parts[0] === "ar") parts.shift();
          var rest = parts.length ? "/" + parts.join("/") + "/" : "/";
          var target = saved === "fr" ? rest : rest === "/" ? "/" + saved + "/" : "/" + saved + rest;
          location.replace(target + location.search + location.hash);
        } catch (e) {}
      })();
    </script>
    <link rel="icon" type="image/png" href="/favicon.png?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f4efe6" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={absolute(alts.fr)} />
    <link rel="alternate" hreflang="en" href={absolute(alts.en)} />
    <link rel="alternate" hreflang="ar" href={absolute(alts.ar)} />
    <link rel="alternate" hreflang="x-default" href={absolute(alts.fr)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={page === "actualites" ? "article" : "website"} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={absolute(ogImage)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absolute(ogImage)} />
    {jsonLd.map((entry) => <script type="application/ld+json" is:inline set:html={JSON.stringify(entry)} />)}
    <link rel="dns-prefetch" href="https://res.cloudinary.com" />
    <link rel="preconnect" href="https://res.cloudinary.com" />
    <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
    {preload && (
      <link
        rel="preload"
        as="image"
        href={preload}
        imagesrcset={preloadSrcset}
        imagesizes={preloadSizes}
        fetchpriority="high"
      />
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,500&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,500&display=swap"
        rel="stylesheet"
      />
      <style>
        .reveal, img { opacity: 1 !important; transform: none !important; animation: none !important; }
      </style>
    </noscript>
  </head>
  <body data-page={page} data-mix={mix} data-product={product} data-fam={fam} data-xp={xp}>
    <a class="skip" href="#content">{t("skip", locale)}</a>
    <Header locale={locale} active={nav} path={path} />
    <main id="content">
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      import "../main.js";
    </script>
  </body>
</html>
