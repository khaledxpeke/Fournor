---
import Base from "../layouts/BaseLayout.astro";
import EventCard from "../components/EventCard.astro";
import { events } from "virtual:fournor-catalog";
import { t } from "../i18n.js";
import { absolute, loc } from "../lib/locale.js";

const { locale = "fr" } = Astro.props;
const tr = (key) => t(key, locale);
const pageUrl = absolute(locale === "fr" ? "/actualites/" : `/${locale}/actualites/`);
const articles = events.map((event) => ({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": `${pageUrl}#${event.id}`,
  name: loc(event.title, locale),
  description: loc(event.text, locale),
  image: absolute(event.image.split("?")[0]),
  url: pageUrl,
  address: {
    "@type": "PostalAddress",
    addressLocality: loc(event.place, locale),
    addressCountry: "TN",
  },
}));
---

<Base
  title={tr("meta.actualites")}
  description={tr("meta.desc.actualites")}
  page="actualites"
  locale={locale}
  path="/actualites/"
  extraLd={articles}
>
  <section class="page-hero wrap">
    <p class="kicker">{tr("page.kicker")}</p>
    <h1>{tr("news.hero")}</h1>
    <p class="lead">{tr("news.lead")}</p>
  </section>
  <section class="section" style="padding-top:0">
    <div class="wrap" id="news-list">
      {events.map((event) => <EventCard event={event} locale={locale} />)}
    </div>
  </section>
</Base>
