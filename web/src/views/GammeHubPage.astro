---
import Base from "../layouts/BaseLayout.astro";
import { gammes } from "virtual:fournor-catalog";
import { t } from "../i18n.js";
import { loc, localePath } from "../lib/locale.js";
import CmsImage from "../components/CmsImage.astro";

const { locale = "fr" } = Astro.props;
const tr = (key) => t(key, locale);
const href = (to) => localePath(locale, to);
---

<Base
  title={tr("meta.gamme")}
  description={tr("meta.desc.gamme")}
  page="gamme"
  locale={locale}
  path="/gamme/"
>
  <section class="page-hero wrap">
    <h1 id="gamme-title">{tr("gamme.hero")}</h1>
    <p class="lead" id="gamme-lead">{tr("gamme.lead")}</p>
  </section>
  <section class="section mix-landing" style="padding-top:0">
    <div class="wrap">
      <div class="mix-hub" id="mix-hub">
        {
          gammes.map((gamme) => (
            <a class="mix-tile" href={href(`/gamme/${gamme.slug}/`)}>
              <span class="mix-tile-label">{loc(gamme.name, locale)}</span>
              <span class="mix-tile-photo">
                <CmsImage src={gamme.image} alt="" slot="tile" loading="lazy" />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>
