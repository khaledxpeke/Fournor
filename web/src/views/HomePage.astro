---
import Base from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import EventCard from "../components/EventCard.astro";
import CtaBand from "../components/CtaBand.astro";
import CmsImage from "../components/CmsImage.astro";
import { events, home, products } from "virtual:fournor-catalog";
import { t } from "../i18n.js";
import { loc, localePath } from "../lib/locale.js";
import { preloadFor } from "../lib/images.js";

const { locale = "fr" } = Astro.props;
const tr = (key) => t(key, locale);
const href = (to) => localePath(locale, to);
const names = products.map((product) => loc(product.name, locale));
const hero = preloadFor(home.hero, "hero");
const band = home.band[0];
const gridSlots = ["adTile", "adTile", "adTile", "adPhoto"];
---

<Base
  title={tr("meta.home")}
  description={tr("meta.desc.home")}
  page="home"
  locale={locale}
  path="/"
  preload={hero.href}
  preloadSrcset={hero.srcset}
  preloadSizes={hero.sizes}
  ogImage={home.hero}
>
  <section class="hero">
    <CmsImage class="hero-bg" src={home.hero} alt="" slot="hero" fetchpriority="high" />
    <h1 class="visually-hidden">{tr("hero.title")}</h1>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {names.map((name) => <span>{name}</span>)}
      {names.map((name) => <span>{name}</span>)}
    </div>
  </div>

  <section class="section">
    <div class="wrap sol-intro reveal">
      <figure class="mix-photo">
        <CmsImage src={home.solution} alt={tr("nav.solution")} slot="pillar" loading="lazy" />
      </figure>
      <div class="mix-copy">
        <h2 class="pillar-heading">{tr("nav.solution")}</h2>
        <p class="pillar-tagline">
          <span class="pillar-fit-ref">{tr("maison.titleFit")}</span><span>{tr("maison.titleRest")}</span>
        </p>
        <p>{tr("maison.text")}</p>
        <a class="btn btn-gold" href={href("/solution/")}>{tr("maison.more")}</a>
      </div>
    </div>
  </section>

  {band && (
    <aside class="ad-band">
      <a class="ad-frame reveal" href={href(band.href)} aria-label={loc(band.alt, locale) || tr("ad.sol.title")}>
        <CmsImage src={band.image} alt="" slot="adBand" loading="lazy" />
      </a>
    </aside>
  )}

  <section class="mix-band">
    <div class="wrap">
      <div class="mix-intro reveal">
        <div class="mix-copy">
          <h2 class="pillar-heading">{tr("atelier.kicker")}</h2>
          <p class="pillar-tagline">
            <span class="pillar-fit-ref">{tr("atelier.titleFit")}</span><span>{tr("atelier.titleRest")}</span>
          </p>
          <p>{tr("atelier.lead")}</p>
          <a class="btn btn-ghost" href={href("/gamme/")}>{tr("atelier.all")}</a>
        </div>
        <figure class="mix-photo">
          <CmsImage src={home.atelier} alt={tr("atelier.kicker")} slot="mix" loading="lazy" />
        </figure>
      </div>
      <div class="atelier-stage">
        <button type="button" class="rail-nav prev" id="atelier-prev" aria-label={tr("atelier.prev")}>‹</button>
        <div class="atelier" id="atelier-rail" tabindex="0">
          <div class="atelier-shift">
            <div class="atelier-track">
              {products.map((product) => <ProductCard product={product} locale={locale} />)}
              {products.map((product) => <ProductCard product={product} locale={locale} decoy />)}
            </div>
          </div>
        </div>
        <button type="button" class="rail-nav next" id="atelier-next" aria-label={tr("atelier.next")}>›</button>
      </div>
      <div class="atelier-dots" id="atelier-dots" role="group" aria-label={tr("atelier.dots")}></div>
    </div>
  </section>

  {home.grid.length > 0 && (
    <aside class="ad-band ad-band-split">
      <div class="ad-grid">
        {home.grid.map((ad, index) => (
          <a class="ad-frame reveal" href={href(ad.href)} aria-label={loc(ad.alt, locale)}>
            <CmsImage src={ad.image} alt="" slot={gridSlots[index] || "adTile"} loading="lazy" />
          </a>
        ))}
      </div>
    </aside>
  )}

  <section class="section">
    <div class="wrap sol-intro reveal">
      <figure class="mix-photo">
        <CmsImage src={home.fournil} alt={tr("fournil.kicker")} slot="pillar" loading="lazy" />
      </figure>
      <div class="mix-copy">
        <h2 class="pillar-heading">{tr("fournil.kicker")}</h2>
        <p class="pillar-tagline">
          <span class="pillar-fit-ref">{tr("fournil.titleFit")}</span><span>{tr("fournil.titleRest")}</span>
        </p>
        <p>{tr("fournil.text")}</p>
        <a class="btn btn-gold" href={href("/ingredients/")}>{tr("fournil.cta")}</a>
      </div>
    </div>
  </section>

  {events.length > 0 && (
    <section class="section" style="padding-top:0">
      <div class="wrap">
        <div class="section-head reveal">
          <p class="kicker">{tr("news.kicker")}</p>
          <h2>{tr("news.title")}</h2>
          <a class="more" href={href("/actualites/")}>{tr("news.all")}</a>
        </div>
        <div id="home-news">
          {events.slice(0, 3).map((event) => <EventCard event={event} locale={locale} />)}
        </div>
      </div>
    </section>
  )}

  <CtaBand locale={locale} />
</Base>
