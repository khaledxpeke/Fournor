---
import IngredientFamilyPage from "../../views/IngredientFamilyPage.astro";
import { ingSlugs } from "virtual:fournor-catalog";

export function getStaticPaths() {
  return ingSlugs.map((fam) => ({ params: { fam } }));
}

const { fam } = Astro.params;
---
<IngredientFamilyPage locale="fr" fam={fam} />
