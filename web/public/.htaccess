# Old static URLs. Query-string rules are first so ?mix=, ?id= and ?fam=
# are not discarded by the bare-page rules. A trailing ? on the target
# strips the original query string.
<IfModule mod_rewrite.c>
RewriteEngine On

RewriteCond %{QUERY_STRING} (?:^|&)mix=(premix-poudres|mix-poudres|mix-graines|mix-liquides)(?:&|$)
RewriteRule ^gamme\.html$ /gamme/%1/? [R=301,L]

RewriteCond %{QUERY_STRING} (?:^|&)id=(baguette-fournor|tradition|mix-farine-croissant|complet|campagne|cereales-noir|chia-quinoa|maxi-graines|multigrain|mais)(?:&|$)
RewriteRule ^produit\.html$ /produit/%1/? [R=301,L]

RewriteCond %{QUERY_STRING} (?:^|&)id=formation(?:&|$)
RewriteRule ^xp\.html$ /formation/? [R=301,L]

RewriteCond %{QUERY_STRING} (?:^|&)id=(metiers|rd|artisan|industriel|patisserie|agro|autres|xp-ingredient|parcours|solutions-ing|formulation|sur-mesure|analyses|reponses|innovation-hub|innovation|marketing|collections|services|snacking)(?:&|$)
RewriteRule ^xp\.html$ /xp/%1/? [R=301,L]

RewriteCond %{QUERY_STRING} (?:^|&)fam=(poudre|grains|liquide|sans-gluten|divers)(?:&|$)
RewriteRule ^ingredients\.html$ /ingredients/%1/? [R=301,L]

RewriteRule ^index\.html$ /? [R=301,L]
RewriteRule ^maison\.html$ /maison/? [R=301,L]
RewriteRule ^solution\.html$ /solution/? [R=301,L]
RewriteRule ^gamme\.html$ /gamme/? [R=301,L]
RewriteRule ^expertise\.html$ /expertise/? [R=301,L]
RewriteRule ^ingredients\.html$ /ingredients/? [R=301,L]
RewriteRule ^formation\.html$ /formation/? [R=301,L]
RewriteRule ^partenaires\.html$ /partenaires/? [R=301,L]
RewriteRule ^actualites\.html$ /actualites/? [R=301,L]
RewriteRule ^contact\.html$ /contact/? [R=301,L]
</IfModule>
