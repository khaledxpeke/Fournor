# Strapi (cms.fournor.com) — fill these in. Do not commit cms/.env.
# Phase 2 reads UPLOAD_PROVIDER. Leave Cloudinary blank until you paste your account values.
# local = files on disk during development. cloudinary = Strapi uploads only.

HOST=0.0.0.0
PORT=1337
PUBLIC_URL=https://cms.fournor.com
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

DATABASE_CLIENT=mysql
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=fournor
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL=false

UPLOAD_PROVIDER=local
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
CLOUDINARY_FOLDER=fournor

# Publish webhook (Phase 4). Leave empty until the GitHub workflow exists.
WEBHOOK_URL=
WEBHOOK_TOKEN=
