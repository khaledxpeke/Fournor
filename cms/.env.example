# Copy to cms/.env for local development. Never commit cms/.env.
# On Hostinger, set the same names in hPanel. The process must not depend on this file.

HOST=0.0.0.0
PORT=1337
PUBLIC_URL=http://localhost:1337
PROXY=true

APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# First boot creates this super-admin if the email does not exist yet.
# Local values only. Generate a new ADMIN_PASSWORD and STRAPI_API_TOKEN
# on the server. Do not copy the local ones into production.
ADMIN_EMAIL=admin@fournor.com
ADMIN_PASSWORD=

# sqlite locally. For MariaDB 11.8 set DATABASE_CLIENT=mysql and fill
# DATABASE_*. Create the database as utf8mb4 / utf8mb4_unicode_ci.
# Do not put the collation in DATABASE charset: MariaDB rejects it.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=fournor
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=5

# local keeps files in cms/public/uploads (wiped on every Hostinger redeploy).
# Set cloudinary and paste the account values to store Strapi uploads only.
# Existing files in web/public stay in the repository.
UPLOAD_PROVIDER=local
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
CLOUDINARY_FOLDER=fournor

# Written by the first boot. Read-only token for the Astro build. Do not commit it.
STRAPI_API_TOKEN=

# Publish and unpublish ask GitHub to rebuild the site. Leave both empty locally.
# WEBHOOK_URL is the repository_dispatch endpoint, for example
# https://api.github.com/repos/OWNER/REPO/dispatches
# WEBHOOK_TOKEN is a GitHub token that can send that dispatch. Do not commit it.
WEBHOOK_URL=
WEBHOOK_TOKEN=
