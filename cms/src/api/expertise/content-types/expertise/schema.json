{
  "kind": "collectionType",
  "collectionName": "expertises",
  "info": {
    "singularName": "expertise",
    "pluralName": "expertises",
    "displayName": "Expertise",
    "description": "Pages du menu Solution et Expertise"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "titre": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "string",
      "required": true,
      "unique": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "parentSlug": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "accroche": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "chapo": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "texte": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "notes": {
      "type": "component",
      "repeatable": true,
      "component": "shared.note",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "bouton": {
      "type": "component",
      "repeatable": false,
      "component": "shared.bouton",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "ordre": {
      "type": "integer",
      "default": 0,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "sections.hero",
        "sections.bandeau-defilant",
        "sections.image-texte",
        "sections.grille-ads",
        "sections.liste-produits",
        "sections.actualites-recentes",
        "sections.cta",
        "sections.texte"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
